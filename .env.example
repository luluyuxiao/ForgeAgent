FORGE_API_KEY=replace-with-your-provider-key
FORGE_BASE_URL=https://api.deepseek.com
FORGE_MODEL=deepseek-chat

# Ordered provider routes. This example reuses the same DeepSeek credential.
FORGE_FALLBACKS=[{"model":"deepseek-reasoner","base_url":"https://api.deepseek.com","api_key_env":"FORGE_API_KEY"}]

# Optional runtime limits
FORGE_MAX_ROUNDS=24
FORGE_CONTEXT_TOKENS=128000
FORGE_CONTEXT_INPUT_RATIO=0.85
FORGE_MAX_OUTPUT_TOKENS=8192

# Optional runtime spend ceiling. Example prices only; verify the provider's current rates.
# FORGE_MAX_COST_USD=1.00
# FORGE_INPUT_PRICE_PER_MILLION=0.27
# FORGE_OUTPUT_PRICE_PER_MILLION=1.10

# local or docker; Docker network is none or bridge. Isolated mode reuses one
# temporary workspace per runtime; use direct only for immediate real-file edits.
FORGE_SANDBOX=local
FORGE_SANDBOX_IMAGE=forgeagent-sandbox:latest
FORGE_SANDBOX_NETWORK=none
FORGE_SANDBOX_WORKSPACE=isolated

# Optional integrations
# FORGE_MCP_CONFIG=.forgeagent/mcp.json
# FORGE_HOOKS_CONFIG=.forgeagent/hooks.json
# FORGE_TRACE=.forgeagent/run.jsonl
FORGE_LLM_SUMMARY=1

# Optional hybrid Tool search. When unset, Tool search remains offline BM25-only.
# FORGE_TOOL_EMBEDDING_MODEL=text-embedding-3-small
# FORGE_TOOL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Omit this only when the embedding endpoint accepts FORGE_API_KEY.
# FORGE_TOOL_EMBEDDING_API_KEY=replace-with-your-embedding-provider-key
