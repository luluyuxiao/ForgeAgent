{
  "servers": {
    "local-tools": {
      "transport": "stdio",
      "command": "python",
      "args": ["path/to/server.py"],
      "protocol": "2025-11-25"
    },
    "remote-tools": {
      "transport": "http",
      "url": "https://example.com/mcp",
      "protocol": "2026-07-28",
      "headers": {
        "Authorization": "Bearer ${MCP_API_TOKEN}"
      }
    }
  }
}
